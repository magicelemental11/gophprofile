# Credentials for the Compose stack. Passwords are left empty on purpose: run `make env`
# to generate random ones, or fill them in by hand (they go into URLs, keep them URL-safe).
POSTGRES_DB=gophprofile
POSTGRES_USER=gophprofile
POSTGRES_PASSWORD=
RABBITMQ_USER=gophprofile
RABBITMQ_PASSWORD=
MINIO_ROOT_USER=gophprofile
MINIO_ROOT_PASSWORD=

# Settings for running the binaries on the host against the Compose services.
DATABASE_DSN=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?sslmode=disable
AMQP_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@localhost:5672/
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=${MINIO_ROOT_USER}
S3_SECRET_KEY=${MINIO_ROOT_PASSWORD}
S3_BUCKET=avatars
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:8080
RATE_LIMIT_RPS=100
UPLOAD_RATE_LIMIT=10
