{
  "type": "monitor",
  "name": "gophprofile-error-logs",
  "monitor_type": "query_level_monitor",
  "enabled": true,
  "schedule": {"period": {"interval": 1, "unit": "MINUTES"}},
  "inputs": [{
    "search": {
      "indices": ["gophprofile-logs-*"],
      "query": {
        "size": 0,
        "query": {
          "bool": {
            "filter": [
              {"term": {"level": "ERROR"}},
              {"range": {"@timestamp": {"gte": "{{period_end}}||-5m", "lte": "{{period_end}}", "format": "epoch_millis"}}}
            ]
          }
        },
        "aggregations": {"by_service": {"terms": {"field": "service"}}}
      }
    }
  }],
  "triggers": [{
    "name": "Errors in service logs",
    "severity": "2",
    "condition": {"script": {"source": "ctx.results[0].hits.total.value > 0", "lang": "painless"}},
    "actions": []
  }]
}
